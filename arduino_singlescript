#include <7Semi_BNO055.h>
#include <SoftwareSerial.h>
BNO055_7Semi imu;
SoftwareSerial otherUno (2,3); 
void setup() {
  Serial.begin(115200);
  otherUno.begin(115200);
  pinMode(2, INPUT);
  pinMode(3, OUTPUT);
  Serial.println("Ready");
  
  if (!imu.begin())
    {
        Serial.println("BNO055 not detected!");
        while (true);
    }
}

void loop() {
  int x, y, z;

  imu.readAccel(x, y, z);
  int output = abs(x)+abs(y)+abs(z);
  delay(250);

  while (Serial.available() > 0) {
    otherUno.write();
  }

  while(otherUno.available() > 0) {
    Serial.write(otherUno.read());
  }
} 
